0","Tinos":"YACkoJyNZF4,0","Tiro Devanagari Hindi":"YAGWNCjUq0o,0","Titan One":"YAHO2v8eA3A,0","Titillium Web":"YAFdtTOE9xo,0","Trebuchet MS":"YAFcfrglpVA,0","Ubuntu":"YACgERDU--Q,0","Ubuntu Condensed":"YAHO2nCaahY,0","Ubuntu Mono":"YAHO2g6B-Uo,0","Ultra":"YACgEWHSPx0,0","Unbounded":"YAHO2rkdmWY,0","Unica One":"YALBs74Pdjc,0","Unna":"YADK4PtOh7E,0","Urbanist":"YAHO2o1IFy0,0","Varela":"YAHO2gPi4IU,0","Varela Round":"YALBs2IK6rw,0","Vazirmatn":"YAHO2z1lH5c,0","Verdana":"YAGzXTctYtQ,0","Vidaloka":"YACgEdRnAX0,0","Viga":"YAHO2v8Lzbg,0","Volkhov":"YAHO2uWq-qg,0","Vollkorn":"YAFdJli9wSA,0","VT323":"YACgEYI9BCI,0","Wix Madefor Display":"YAHO2o-Qfis,0","Wix Madefor Text":"YAHO2rU16Qc,0","Work Sans":"YAGXhLOKv44,0","Yanone Kaffeesatz":"YAFdtbpuM0E,0","Yantramanav":"YAFdJuZAcfY,0","Yellowtail":"YACgEYG4kG4,0","Yeseva One":"YALBs4GWnJw,0","Ysabeau":"YAHMLjcdG48,0","Ysabeau Office":"YAHO2uUYDYI,0","Zalando Sans":"YAHO2k5OK-M,0","Zalando Sans Expanded":"YAHO2h6OPds,0","Zen Kaku Gothic Antique":"YAHO2u8F_xk,0","Zen Kaku Gothic New":"YAHO2tS_yps,0","Zen Maru Gothic":"YAFdJgMrcdw,0","Zen Old Mincho":"YAHO2tMwaEs,0","Zeyada":"YAHO2lP62P0,0","Zilla Slab":"YAFdJpPotmI,0"}}');</script><script src="/_sdk/640c2c9485552aa0.telemetry_sdk.js" integrity="sha512-x7sJNwBS9reCVXham9nBdUp9EtXT/bbNZQpT1cWbDa+n6qr1jm8WdBMFUK+gVfm5CtLZVOtKSGRXT0C+rD4Hdw=="></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edebiyat Çarkıfelek Tarama Testi</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box} body{margin:0;width:100%;font-family:"DM Sans",sans-serif;color:#2d3748}
    [hidden]{display:none!important} .app-shell{width:100%;min-height:100%;padding:28px 20px 42px}
    .app-title{text-align:center;margin:8px auto 26px;font-weight:700;line-height:1.2}
    .quiz-layout{max-width:1200px;width:100%;margin:auto;display:flex;flex-wrap:wrap;justify-content:center;align-items:stretch;gap:30px}
    .wheel-card,.question-card,.entry-card,.result-card{background:#fff;border-radius:15px;box-shadow:0 4px 15px rgba(0,0,0,.1)}
    .entry-card,.result-card{width:min(100%,590px);margin:0 auto;padding:32px}
    .entry-card h2,.result-card h2{margin:0 0 9px;color:#1a365d;font-weight:700}
    .intro-copy{margin:0 0 24px;line-height:1.6;color:#4a5568}
    .field{margin:0 0 18px}.field label,.choice-label{display:block;margin-bottom:8px;font-weight:700;color:#2d3748}
    .field input{width:100%;border:2px solid #cbd5e0;border-radius:9px;padding:12px 14px;background:#fff;color:#2d3748}
    .field input:focus-visible{outline:3px solid #3182ce;outline-offset:2px}
    .choice-list{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:22px}
    .choice{position:relative;flex:1 1 145px}.choice input{position:absolute;width:1px;height:1px;opacity:0}
    .choice span{display:block;text-align:center;padding:12px 10px;border:2px solid #cbd5e0;border-radius:9px;cursor:pointer;font-weight:700}
    .choice input:checked+span{border-color:#3182ce;background:#ebf8ff;color:#1a365d}
    .choice input:focus-visible+span{outline:3px solid #1a365d;outline-offset:3px}
    .primary-button,.secondary-button{border:0;border-radius:25px;padding:12px 25px;font-weight:700;cursor:pointer;transition:transform .2s,background-color .2s}
    .primary-button{background:#3182ce;color:#fff}.primary-button:hover:not(:disabled){background:#2b6cb0;transform:scale(1.03)}
    .secondary-button{background:#edf2f7;color:#1a365d}.secondary-button:hover:not(:disabled){background:#e2e8f0}
    button:disabled{opacity:.5;cursor:not-allowed}
    .form-error{color:#c53030;font-weight:600;margin:0 0 14px}
    .student-strip{max-width:1200px;margin:0 auto 18px;padding:10px 16px;background:#ebf8ff;border-radius:9px;color:#1a365d;font-weight:700}
    .wheel-card{padding:24px;display:flex;flex-direction:column;align-items:center}
    .wheel-wrap{position:relative;width:min(350px,calc(100vw - 88px));aspect-ratio:1}
    #wheel{display:block;width:100%;height:100%;border:5px solid #2b6cb0;border-radius:50%}
    .pointer{position:absolute;top:-10px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:15px solid transparent;border-right:15px solid transparent;border-top:25px solid #e53e3e;z-index:2;filter:drop-shadow(0 2px 2px #0003)}
    .spin-button{margin-top:22px}
    .score-board{width:100%;margin-top:23px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 22px;font-weight:700}
    .question-card{flex:1 1 350px;min-width:0;padding:26px;display:flex;flex-direction:column;justify-content:center;min-height:460px}
    .placeholder{text-align:center;margin:auto;line-height:1.5;color:#a0aec0}
    .category-badge{display:inline-block;align-self:flex-start;padding:6px 13px;border-radius:20px;color:#fff;font-weight:700;font-size:14px;margin-bottom:17px}
    .question-text{font-size:18px;font-weight:600;line-height:1.5;margin:0 0 20px}
    .options{display:flex;flex-direction:column;gap:10px}
    .option-button{width:100%;padding:12px 15px;text-align:left;background:#edf2f7;border:2px solid #e2e8f0;border-radius:8px;font-size:15px;color:#2d3748;cursor:pointer;transition:background-color .2s,border-color .2s}
    .option-button:hover:not(:disabled){background:#e2e8f0;border-color:#cbd5e0}
    .option-button.correct{background:#c6f6d5!important;border-color:#38a169!important;color:#22543d!important;font-weight:700}
    .option-button.wrong{background:#fed7d7!important;border-color:#e53e3e!important;color:#742a2a!important}
    .option-button:disabled{cursor:default}
    .feedback{margin:17px 0 0;font-weight:700;line-height:1.5}
    .question-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
    .result-student{margin:12px 0 22px;color:#4a5568;line-height:1.6}
    .result-score{margin:0 0 22px;padding:16px;border-radius:10px;background:#ebf8ff;color:#1a365d;font-weight:700}
    .stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-bottom:24px}
    .stat{background:#f7fafc;border-radius:10px;padding:15px}.stat-label{display:block;color:#4a5568}.stat strong{display:block;margin-top:5px;color:#1a365d;font-size:23px}
    button:focus-visible{outline:3px solid #1a365d;outline-offset:3px}
    @media(max-width:740px){.app-shell{padding:20px 14px 30px}.quiz-layout{gap:18px}.wheel-card,.question-card{width:100%}.question-card{min-height:250px;padding:22px}.wheel-wrap{width:min(350px,calc(100vw - 76px))}.entry-card,.result-card{padding:24px}.stats{grid-template-columns:1fr 1fr}}
    @media(prefers-reduced-motion:reduce){.primary-button,.secondary-button,.option-button{transition:none}}
  </style>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.577.0/dist/umd/lucide.min.js" type="text/javascript"></script>
  <script src="https://cdn.tailwindcss.com/3.4.17" type="text/javascript"></script>
  <script src="/_sdk/8fed440c6f94b5da.data_sdk.js" type="text/javascript" integrity="sha512-hrvcCCJ6nkL5gG3mdqPDbgyAf9a/fg/zBF51sU5N3rM1WmeSu8K36+6wn9TZeAZrLIonoaPBeVyFsXxXxZjq0w=="></script>
  <script src="/_sdk/9d41678d006ee11b.editing_sdk.js" type="text/javascript" integrity="sha512-Ebb/q1G7Ju5w6lW2bCf7M0giMpkjzuRef3chCo8rCqL5zFGZ28lEdnx1VdpfPToUoMbcgumcGqlCzobErKJ62w=="></script>
  <script src="/_sdk/dfeb017e55db4863.resizing_sdk.js" type="text/javascript" integrity="sha512-kbPBNN/FAxsctln1jqNvXyIdF7mIhQx0C+eGGC2IF3mNjNZZcftDT1wFztswSSk4KXRWYHIC3uA9NMfJV4IVUw=="></script>
 </head>
 <body data-template-id="__page-root" style="background: rgb(240, 242, 245);">
  <div class="app-shell">
   <header>
    <h1 data-template-id="page-title" class="canva-text app-title" style="color: rgb(26, 54, 93); font-weight: 700; font-style: normal; font-size: 32px;">11. Sınıf Edebiyat Çarkıfelek Tarama Testi</h1>
   </header>
   <main>
    <section id="entry-screen" data-template-id="entry-section" class="canva-card entry-card" aria-labelledby="entry-title" style="background: rgb(255, 255, 255);">
     <h2 id="entry-title" data-template-id="entry-title" class="canva-text" style="color: rgb(26, 54, 93); font-weight: 700; font-style: normal; font-size: 24px;">Teste Başla</h2>
     <p data-template-id="entry-description" class="canva-text intro-copy" style="color: rgb(74, 85, 104); font-weight: 400; font-style: normal; font-size: 16px;">Bilgilerini gir, soru sayısını seç ve edebiyat çarkını çevirmeye hazırlan.</p>
     <form id="entry-form" novalidate="">
      <div class="field">
       <label for="student-name" data-template-id="student-name-label" class="canva-text" style="color: rgb(45, 55, 72); font-weight: 700; font-style: normal; font-size: 16px;">Öğrenci adı ve soyadı</label><input id="student-name" autocomplete="name" required="" maxlength="100" data-template-id="student-name-input" class="canva-input" placeholder="Adınızı ve soyadınızı yazın" style="font-weight: 400; font-style: normal; font-size: 16px;">
      </div>
      <div class="field">
       <label for="student-class" data-template-id="student-class-label" class="canva-text" style="color: rgb(45, 55, 72); font-weight: 700; font-style: normal; font-size: 16px;">Sınıf / şube</label><input id="student-class" required="" maxlength="40" data-template-id="student-class-input" class="canva-input" placeholder="Örnek: 11/A" style="font-weight: 400; font-style: normal; font-size: 16px;">
      </div>
      <fieldset>
       <legend data-template-id="count-legend" class="canva-text choice-label" style="color: rgb(45, 55, 72); font-weight: 700; font-style: normal; font-size: 16px;">Kaç soru çözmek istersin?</legend>
       <div class="choice-list"><label class="choice"><input type="radio" name="count" value="10" required=""><span data-template-id="count-10" class="canva-text" style="font-weight: 400; font-style: normal; font-size: 16px;">10 soru çöz</span></label> <label class="choice"><input type="radio" name="count" value="20"><span data-template-id="count-20" class="canva-text" style="font-weight: 400; font-style: normal; font-size: 16px;">20 soru çöz</span></label> <label class="choice"><input type="radio" name="count" value="50"><span data-template-id="count-50" class="canva-text" style="font-weight: 400; font-style: normal; font-size: 16px;">50 soru çöz</span></label>
       </div>
      </fieldset>
      <p id="form-error" data-template-id="form-error" class="canva-text form-error" role="alert" hidden="" style="color: rgb(197, 48, 48); font-weight: 600; font-style: normal; font-size: 16px;">Başlamak için öğrenci bilgilerini doldur ve soru sayısını seç.</p><button type="submit" data-template-id="begin-button" class="canva-button primary-button" style="background: rgb(49, 130, 206); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">TESTİ BAŞLAT</button>
     </form>
    </section>
    <div id="test-screen" hidden="">
     <div class="student-strip">
      <span data-template-id="student-strip-label" class="canva-text" style="color: rgb(26, 54, 93); font-weight: 700; font-style: normal; font-size: 16px;">Öğrenci:</span> <span id="student-display"></span> · <span id="class-display"></span>
     </div>
     <div class="quiz-layout">
      <section data-template-id="wheel-section" class="canva-card wheel-card" aria-label="Kategori çarkı" style="background: rgb(255, 255, 255);">
       <div class="wheel-wrap">
        <div class="pointer" aria-hidden="true"></div>
        <canvas id="wheel" width="350" height="350" role="img" aria-label="Çok Kolay, Kolay, Orta, Zor, Çok Zor ve Karışık kategorilerinden oluşan çark"></canvas>
       </div><button type="button" id="spin-button" data-template-id="spin-button" class="canva-button primary-button spin-button" style="background: rgb(49, 130, 206); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 18px;">ÇARKI ÇEVİR</button>
       <div class="score-board" aria-live="polite">
        <span><span data-template-id="score-label" class="canva-text" style="color: rgb(74, 85, 104); font-weight: 700; font-style: normal; font-size: 16px;">Puan:</span> <span id="score-value">0 / 100</span></span><span><span data-template-id="remaining-label" class="canva-text" style="color: rgb(74, 85, 104); font-weight: 700; font-style: normal; font-size: 16px;">Kalan Soru:</span> <span id="remaining-value">0</span></span>
       </div>
      </section>
      <section data-template-id="question-section" class="canva-card question-card" aria-label="Soru ve cevaplar" style="background: rgb(255, 255, 255);">
       <p id="start-message" data-template-id="start-message" class="canva-text placeholder" style="color: rgb(160, 174, 192); font-weight: 400; font-style: normal; font-size: 18px;">Soru çekmek için çarkı çevirin!</p>
       <div id="question-view" hidden="">
        <div id="category-badge" class="category-badge"></div>
        <h2 id="question-text" class="question-text"></h2>
        <div id="options" class="options"></div>
        <p id="wrong-feedback" data-template-id="wrong-feedback" class="canva-text feedback" role="status" hidden="" style="color: rgb(197, 48, 48); font-weight: 700; font-style: normal; font-size: 16px;">Yanlış cevap. Doğru seçenek yeşil renkle gösterildi. Bir kez daha deneyebilirsin; bu soru henüz tamamlanmadı.</p>
        <p id="retry-correct-feedback" data-template-id="retry-correct-feedback" class="canva-text feedback" role="status" hidden="" style="color: rgb(34, 84, 61); font-weight: 700; font-style: normal; font-size: 16px;">Tekrar denemede doğru! Bu sorunun puanının yarısını kazandın.</p>
        <p id="retry-wrong-feedback" data-template-id="retry-wrong-feedback" class="canva-text feedback" role="status" hidden="" style="color: rgb(197, 48, 48); font-weight: 700; font-style: normal; font-size: 16px;">Tekrar denemede de yanlış cevap. Doğru seçenek gösterildi; bu soru için puan kazanılmadı.</p>
        <p id="first-correct-feedback" data-template-id="first-correct-feedback" class="canva-text feedback" role="status" hidden="" style="color: rgb(34, 84, 61); font-weight: 700; font-style: normal; font-size: 16px;">Doğru cevap! Bu sorunun tam puanını kazandın.</p>
        <div class="question-actions"><button id="retry-button" type="button" data-template-id="retry-button" class="canva-button secondary-button" hidden="" style="background: rgb(237, 242, 247); color: rgb(26, 54, 93); font-weight: 700; font-style: normal; font-size: 16px;">Tekrar Dene</button> <button id="next-button" type="button" data-template-id="next-button" class="canva-button primary-button" hidden="" style="background: rgb(49, 130, 206); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">Sonraki Soru İçin Çarkı Çevir</button> <button id="finish-button" type="button" data-template-id="finish-button" class="canva-button primary-button" hidden="" style="background: rgb(49, 130, 206); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">Sonuçları Gör</button>
        </div>
       </div>
       <div id="empty-view" hidden="">
        <h2 data-template-id="empty-title" class="canva-text" style="color: rgb(26, 54, 93); font-weight: 700; font-style: normal; font-size: 24px;">Bu kategoride soru kalmadı!</h2>
        <p data-template-id="empty-description" class="canva-text" style="color: rgb(74, 85, 104); font-weight: 400; font-style: normal; font-size: 16px;">Başka bir kategoriden soru seçmek için çarkı tekrar çevirin.</p>
       </div>
      </section>
     </div>
    </div>
    <section id="result-screen" data-template-id="result-section" class="canva-card result-card" hidden="" style="background: rgb(255, 255, 255);">
     <h2 data-template-id="result-title" class="canva-text" style="color: rgb(26, 54, 93); font-weight: 700; font-style: normal; font-size: 24px;">Test Tamamlandı!</h2>
     <p class="result-student"><span data-template-id="result-student-label" class="canva-text" style="color: rgb(74, 85, 104); font-weight: 400; font-style: normal; font-size: 16px;">Öğrenci:</span> <strong id="result-student"></strong><br><span data-template-id="result-class-label" class="canva-text" style="color: rgb(74, 85, 104); font-weight: 400; font-style: normal; font-size: 16px;">Sınıf / şube:</span> <strong id="result-class"></strong></p>
     <p class="result-score"><span data-template-id="result-score-label" class="canva-text" style="color: rgb(26, 54, 93); font-weight: 700; font-style: normal; font-size: 16px;">Toplam Puan:</span> <span id="final-score"></span></p>
     <div class="stats">
      <div class="stat">
       <span data-template-id="correct-label" class="canva-text stat-label" style="color: rgb(74, 85, 104); font-weight: 400; font-style: normal; font-size: 16px;">İlk denemede doğru</span><strong id="correct-count">0</strong>
      </div>
      <div class="stat">
       <span data-template-id="wrong-label" class="canva-text stat-label" style="color: rgb(74, 85, 104); font-weight: 400; font-style: normal; font-size: 16px;">Yanlış cevaplanan</span><strong id="wrong-count">0</strong>
      </div>
      <div class="stat">
       <span data-template-id="retry-correct-label" class="canva-text stat-label" style="color: rgb(74, 85, 104); font-weight: 400; font-style: normal; font-size: 16px;">Tekrar denemede doğru</span><strong id="retry-correct-count">0</strong>
      </div>
      <div class="stat">
       <span data-template-id="earned-label" class="canva-text stat-label" style="color: rgb(74, 85, 104); font-weight: 400; font-style: normal; font-size: 16px;">Kazanılan toplam puan</span><strong id="earned-score">0 / 100</strong>
      </div>
     </div><button id="restart-button" type="button" data-template-id="restart-button" class="canva-button primary-button" style="background: rgb(49, 130, 206); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">Yeniden Başla</button>
    </section>
   </main>
  </div>
  <script>
  // Her soru: metin, dört seçenek ve doğru seçeneğin sıfır tabanlı indeksi.
  const raw = {
    "Çok Kolay":[
      ["1. Karagöz oyununda okumamış halk kesimini temsil eden ana karakter kimdir?","Hacivat","Çelebi","Karagöz","Pişekâr",2],
      ["2. Mektubun dijitalleşmiş, elektronik ortamdaki şekline ne ad verilir?","Dilekçe","E-posta","Tezkire","Monografi",1],
      ["3. Türk dilinin ve edebiyatının bilinen ilk yazılı belgesi kabul edilen anıt hangisidir?","Kutadgu Bilig","Orhun Abideleri","Divânu Lugâti't-Türk","Atabetü'l-Hakâyık",1],
      ["4. Divan edebiyatında şairlerin hayatını ve eserlerini anlatan biyografik eserlere ne ad verilir?","Tezkire","Roman","Trajedi","Dilekçe",0],
      ["5. 'Gülerim, gülersin, güler...' çekimi fiil kiplerinden hangisine aittir?","Şimdiki Zaman","Gelecek Zaman","Geniş Zaman","Gereklilik Kipi",2],
      ["6. Tiyatroda oyuncunun rol gereği yaptığı el, kol ve beden hareketlerine ne denir?","Mimik","Jest","Tirat","Suflör",1],
